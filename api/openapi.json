{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "Bad request, or a query parameter that is not allowed"
      },
      "Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "Conflicts with the current state"
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "Wrong Host, or an Origin header"
      },
      "InternalError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "Internal error"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "No such resource"
      },
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "Rate limited; see Retry-After"
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        },
        "description": "Missing, invalid or revoked device key"
      }
    },
    "schemas": {
      "ApiVersion": {
        "description": "The contract a server speaks: `/api/<major>` and its additions so far.",
        "properties": {
          "major": {
            "description": "`v1`.",
            "type": "string"
          },
          "minor": {
            "description": "Bumped on every additive change within the major.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "major",
          "minor"
        ],
        "type": "object"
      },
      "AuditEntry": {
        "description": "One audited change.",
        "properties": {
          "action": {
            "description": "Dotted: `device_key.created`, `setting.set`, ….",
            "type": "string"
          },
          "actor": {
            "$ref": "#/components/schemas/EventActor"
          },
          "at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "details": {
            "type": "object"
          },
          "entity_id": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "entity_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "seq": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "seq",
          "at",
          "action",
          "actor",
          "details"
        ],
        "type": "object"
      },
      "AuditPage": {
        "description": "A page of the audit log, newest first. `next_before` continues with older rows, absent on\nthe last page.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            },
            "type": "array"
          },
          "next_before": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Device": {
        "description": "A device's key, without the key.",
        "properties": {
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "last_used_at": {
            "$ref": "#/components/schemas/Timestamp",
            "description": "Marked at most once a minute."
          },
          "name": {
            "type": "string"
          },
          "revoked_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "A JSON error: a stable `code` and a message for people.",
        "properties": {
          "code": {
            "type": "string"
          },
          "error_id": {
            "description": "`err_` and a ULID, unique to this answer: logged with it (and, for a refused write,\naudited as `api.refused`), for the app's \"Copy error\".",
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "error_id"
        ],
        "type": "object"
      },
      "Event": {
        "description": "One entry of the event stream. `seq` only grows: it is the replay cursor. New kinds may be\nadded: a client skips an event whose kind it does not know.",
        "properties": {
          "at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "kind": {
            "description": "What happened: `audit` (an audited change; the payload is the audit row: `audit_seq`,\n`action`, `actor_kind`, `actor_id`, `entity_kind`, `entity_id`, `details`), or a kind a\nmodule writes.",
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "seq": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "seq",
          "at",
          "kind",
          "payload"
        ],
        "type": "object"
      },
      "EventActor": {
        "description": "Who acted, on an audited change.",
        "discriminator": {
          "mapping": {
            "system": "#/components/schemas/EventActorSystem",
            "user": "#/components/schemas/EventActorUser"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/EventActorUser"
          },
          {
            "$ref": "#/components/schemas/EventActorSystem"
          }
        ]
      },
      "EventActorSystem": {
        "properties": {
          "kind": {
            "enum": [
              "system"
            ],
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "EventActorUser": {
        "properties": {
          "kind": {
            "enum": [
              "user"
            ],
            "type": "string"
          },
          "user_id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "user_id",
          "kind"
        ],
        "type": "object"
      },
      "IssuedDevice": {
        "description": "A new device and its key: the only time the key is ever shown.",
        "properties": {
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "key": {
            "type": "string"
          }
        },
        "required": [
          "device",
          "key"
        ],
        "type": "object"
      },
      "LatestEvent": {
        "description": "The newest event's seq a client would be shown: the catch-up target.",
        "properties": {
          "seq": {
            "description": "0 when there is none yet.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "seq"
        ],
        "type": "object"
      },
      "Me": {
        "description": "The calling device and what the server speaks.",
        "properties": {
          "device": {
            "$ref": "#/components/schemas/Named"
          },
          "versions": {
            "$ref": "#/components/schemas/Versions"
          }
        },
        "required": [
          "device",
          "versions"
        ],
        "type": "object"
      },
      "Named": {
        "description": "A device: who, by id and name.",
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "NewDevice": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Page_Event": {
        "description": "A page of a list. `next_after` is the cursor of the next page, absent on the last.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array"
          },
          "next_after": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "PairBody": {
        "properties": {
          "code": {
            "description": "The code the admin was shown, in any case.",
            "type": "string"
          },
          "name": {
            "description": "What to call the new device.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "type": "object"
      },
      "Pairing": {
        "properties": {
          "code": {
            "description": "Six characters, letters and digits; shown to the user once.",
            "type": "string"
          },
          "expires_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "required": [
          "code",
          "expires_at"
        ],
        "type": "object"
      },
      "PushToken": {
        "description": "The calling device's APNs token (E10.4).",
        "properties": {
          "sandbox": {
            "description": "A development build's token, for the sandbox gateway.",
            "type": "boolean"
          },
          "token": {
            "description": "The device token, hex, as the app got it from APNs.",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "SetSetting": {
        "description": "A value to set: an integer in the setting's unit.",
        "properties": {
          "value": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "Setting": {
        "description": "One setting and its effective value at the scope asked about.",
        "properties": {
          "default": {
            "format": "int64",
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "key": {
            "description": "E.g. `api.request_burst`.",
            "type": "string"
          },
          "max": {
            "format": "int64",
            "type": "integer"
          },
          "min": {
            "description": "The bounds a value must be within.",
            "format": "int64",
            "type": "integer"
          },
          "scopes": {
            "description": "Where it may be set; the most specific with a value wins.",
            "items": {
              "$ref": "#/components/schemas/SettingScope"
            },
            "type": "array"
          },
          "source": {
            "description": "Where `value` was set (`server`); absent: the default.",
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "$ref": "#/components/schemas/SettingUnit"
          },
          "value": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "description",
          "unit",
          "default",
          "min",
          "max",
          "scopes",
          "value"
        ],
        "type": "object"
      },
      "SettingChange": {
        "description": "One set or reset, newest first.",
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/EventActor"
          },
          "at": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "new": {
            "description": "What was set; absent for a reset.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "old": {
            "description": "What was set at `scope` before; absent when it inherited.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "scope": {
            "type": "string"
          },
          "seq": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "seq",
          "at",
          "actor",
          "scope"
        ],
        "type": "object"
      },
      "SettingScope": {
        "anyOf": [
          {
            "enum": [
              "server"
            ],
            "type": "string"
          },
          {
            "type": "string"
          }
        ]
      },
      "SettingUnit": {
        "anyOf": [
          {
            "enum": [
              "seconds",
              "milliseconds",
              "percent",
              "count",
              "bytes",
              "per_minute"
            ],
            "type": "string"
          },
          {
            "type": "string"
          }
        ]
      },
      "Timestamp": {
        "description": "RFC 3339 UTC with exactly milliseconds, `2026-10-21T12:00:00.250Z`: one shape, so a\nclient's date parser never meets a second one (E0.4).",
        "format": "date-time",
        "type": "string"
      },
      "Versions": {
        "description": "What the server is and speaks.",
        "properties": {
          "api": {
            "$ref": "#/components/schemas/ApiVersion"
          },
          "git_sha": {
            "description": "The commit it was built from (short sha), when the build knew it.",
            "type": [
              "string",
              "null"
            ]
          },
          "server": {
            "description": "The server's crate version, `0.1.0`.",
            "type": "string"
          }
        },
        "required": [
          "server",
          "api"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "device_key": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The Ainkrad Core client API, for the Ainkrad app. Every request carries a device key as `Authorization: Bearer` (never in the URL) and the server's own `Host`, and no `Origin`. Times are RFC 3339 UTC with milliseconds. Versioning: within /api/v1, enum values, union variants, optional fields and operations may be added; a client must keep an unknown enum value (every enum is open) and skip an event or union variant it cannot decode. Anything removed or renamed is a new /api/v2. `info.version` is `1.<minor>.0`; the minor (`GET /api/v1/me`, `versions.api.minor`) is bumped on every addition.",
    "license": {
      "name": ""
    },
    "title": "Ainkrad Core",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/audit": {
      "get": {
        "operationId": "listAudit",
        "parameters": [
          {
            "description": "Only rows with a `seq` below this (the previous page's `next_before`).",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "At most this many (default and most 100).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Only actions starting with this: `device_key.` or `setting.set`.",
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only rows about this entity: its kind (`device_key`), or kind and id (`device_key:3`).",
            "in": "query",
            "name": "target",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only rows done by this kind of actor: `user` or `system`; another value is a 400.",
            "in": "query",
            "name": "actor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            },
            "description": "Audit rows, newest first. A `target` id that is not a number, or an unknown `actor`, is a 400"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/devices": {
      "get": {
        "operationId": "listDevices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Device"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Every device key, revoked ones too; never a key"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "tags": [
          "devices"
        ]
      },
      "post": {
        "operationId": "createDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewDevice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedDevice"
                }
              }
            },
            "description": "The new device and its key, shown only now"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "tags": [
          "devices"
        ]
      }
    },
    "/api/v1/devices/pair": {
      "post": {
        "operationId": "pairDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedDevice"
                }
              }
            },
            "description": "The new device and its key, shown only now; the code is spent (audited as `device.paired`). Needs no device key. 404 for a code that is unknown, used or expired, counted against the client address; 429 once too many are"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "devices"
        ]
      }
    },
    "/api/v1/devices/pairing": {
      "post": {
        "operationId": "startPairing",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pairing"
                }
              }
            },
            "description": "A pairing code, good once for 5 minutes (audited as `device.pairing_started`)"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "tags": [
          "devices"
        ]
      }
    },
    "/api/v1/devices/{id}": {
      "delete": {
        "operationId": "revokeDevice",
        "parameters": [
          {
            "description": "Device id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            },
            "description": "The revoked device"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Revokes at once, the calling device's own key included; the row stays, marked revoked.",
        "tags": [
          "devices"
        ]
      }
    },
    "/api/v1/events": {
      "get": {
        "operationId": "listEvents",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Event"
                }
              }
            },
