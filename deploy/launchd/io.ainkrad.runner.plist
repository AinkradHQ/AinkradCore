<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.ainkrad.runner</string>
	<!-- Protocol v2 (E2-15). __HOME__ is filled in by deploy/launchd/install.sh, which also appends
	     --enable-agents, and --enable-pty to ProgramArguments when asked. Terminals (pty) and exec.run are OFF unless a flag says so:
	     a terminal is a shell as THIS user, with everything this user can reach (no sandbox on this agent). -->
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/ainkrad-runner</string>
		<string>connect</string>
		<string>--state</string>
		<string>__HOME__/.ainkrad-runner/core</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<!-- Where the runner reports its log from (main.rs); same file as StandardErrorPath. -->
		<!-- Agent sessions with the Core's accounts: the runner advertises egress-filter only with these two (the
		     Seatbelt egress filter then lets sessions reach only these hosts). Same as deploy/install-linux.sh. -->
		<key>AINKRAD_AGENT_NETWORK</key>
		<string>filtered</string>
		<key>AINKRAD_AGENT_EGRESS_HOSTS</key>
		<string>api.anthropic.com</string>
		<key>CITADEL_RUNNER_LOG</key>
		<string>__HOME__/Library/Logs/AinkradRunner/runner.log</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<!-- Terminals outlive the runner: each is a detached ainkrad-ptyhost (its own session). Without this launchd
	     kills every process left in the job's group when the runner exits (stop, upgrade, crash) and with it
	     every terminal. -->
	<key>AbandonProcessGroup</key>
	<true/>
	<!-- Standard, not Background: shells and AI sessions inherit this, and Background puts them on the
	     efficiency cores at priority 4 with throttled I/O and timers (slow terminals, slow sessions). -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ExitTimeOut</key>
	<integer>20</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/AinkradRunner/runner.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/AinkradRunner/runner.log</string>
</dict>
</plist>
