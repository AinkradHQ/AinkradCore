<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.ainkrad.runner</string>
	<!-- __HOME__, __RUNNER_URL__ and __KEY_FILE__ are filled in by deploy/launchd/install.sh. -->
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/ainkrad-runner</string>
		<string>__RUNNER_URL__</string>
		<string>--key-file</string>
		<string>__KEY_FILE__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<!-- Where the runner reports its log from (main.rs); same file as StandardErrorPath. -->
		<key>CITADEL_RUNNER_LOG</key>
		<string>__HOME__/Library/Logs/AinkradRunner/runner.log</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>5</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>ExitTimeOut</key>
	<integer>20</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/AinkradRunner/runner.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/AinkradRunner/runner.log</string>
</dict>
</plist>
