# Written by deploy/install-linux.sh --with-run (loaded by ainkrad-run-egress.service, and again as root by
# ainkrad-run@.service before every run op). Idempotent: the table is replaced as a whole, in one transaction.
# Matches the ainkrad-run uid: rootless Podman's outbound traffic leaves the host from that user's processes (pasta).
table inet ainkrad_run_egress
delete table inet ainkrad_run_egress
table inet ainkrad_run_egress {
  chain out {
    type filter hook output priority 0; policy accept;
    # Replies on connections others opened (a published port on 127.0.0.1) stay open; nothing new passes here.
    meta skuid "ainkrad-run" ct state established,related accept
    # DNS to the host's resolver (systemd-resolved's stub; install-linux.sh --with-run refuses to install without it), the one local service a container may reach.
    meta skuid "ainkrad-run" ip daddr 127.0.0.53 meta l4proto { tcp, udp } th dport 53 accept
    # Every other address of the host itself (loopback, its own private and public addresses).
    meta skuid "ainkrad-run" fib daddr type local reject
    # Cloud metadata (169.254.169.254), Azure's WireServer (168.63.129.16, public address space), private and
    # special-purpose ranges, multicast, and the reserved block with broadcast (240/4 holds 255.255.255.255).
    meta skuid "ainkrad-run" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 168.63.129.16/32, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } reject
    # IPv6 is deny-by-default: a cloud network's own global prefix (VM to VM) is ordinary 2000::/3 space that no static
    # rule can tell from the internet, and ULA, link-local and multicast go with it. DNS is the IPv4 stub above, so
    # names still resolve, and clients fall back to IPv4 at once (reject, not drop).
    meta skuid "ainkrad-run" meta nfproto ipv6 reject
  }
}
