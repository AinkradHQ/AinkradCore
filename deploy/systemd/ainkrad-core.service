# Hardened systemd unit for the Ainkrad Core (E1-14.5). Install with deploy/install-core-linux.sh.
#
# Layout:
#   binary   /usr/local/bin/ainkrad-core-server
#   home     /var/lib/ainkrad/core   (`ainkrad-core-server init`, as user ainkrad: config.toml, core.db,
#                                     keys/, backups/, tls/ (ACME), core-identity.p8, admin.sock)
#   config   /etc/ainkrad/core.env   (AINKRAD_LISTEN, AINKRAD_HOSTNAME, AINKRAD_ACME_CONTACT,
#                                     AINKRAD_BACKUP_RECIPIENT, AINKRAD_SERVE_ARGS; nothing secret)
#            /etc/ainkrad/backup.env (bucket credentials) is NOT loaded here: serve never needs them;
#                                     only a `backup` run sources it.
# The first device enrolls through the admin socket: `sudo -u ainkrad ainkrad-core-server bootstrap
# /var/lib/ainkrad/core/core.db <name>` on the host (the socket admits only the service's own uid).

[Unit]
Description=Ainkrad Core
Documentation=https://github.com/AinkradHQ/AinkradCore
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=ainkrad
Group=ainkrad
EnvironmentFile=-/etc/ainkrad/core.env
Environment=HOME=/var/lib/ainkrad
ExecStart=/usr/local/bin/ainkrad-core-server serve --config /var/lib/ainkrad/core/config.toml $AINKRAD_SERVE_ARGS
# SIGTERM: stop accepting, 10 s for requests in flight, checkpoint.
TimeoutStopSec=20
Restart=on-failure
RestartSec=1s
LimitCORE=0

StateDirectory=ainkrad
StateDirectoryMode=0750
ConfigurationDirectory=ainkrad
ConfigurationDirectoryMode=0750
UMask=0077

# --- Filesystem: read-only system, writable only in the state directory ---
ProtectSystem=strict
ReadWritePaths=/var/lib/ainkrad
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# --- Privileges: only binding :443/:80 ---
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# Not PrivateUsers: capabilities inside a user namespace cannot bind the host's :443.

# --- Network: a public listener, ACME and the backup bucket outbound ---
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
