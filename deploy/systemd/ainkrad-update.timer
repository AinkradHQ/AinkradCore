# E12-3 (D-7): hourly check; update.sh installs only between 02:00 and 05:00 local time, so updates land at night.
# Turn automatic updates off with `systemctl disable --now ainkrad-update.timer`; "Update now" still works.

[Unit]
Description=Ainkrad Core nightly update

[Timer]
OnCalendar=hourly
RandomizedDelaySec=15min
Persistent=true
Unit=ainkrad-update@auto.service

[Install]
WantedBy=timers.target
