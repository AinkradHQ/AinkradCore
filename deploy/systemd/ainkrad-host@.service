# One request to the root host helper, for one connection to ainkrad-host.socket (the connected socket is standard input and
# output). It runs no shell and no installed binary: only `systemctl` and `journalctl`, fixed argv, empty environment.
# State: /var/lib/ainkrad-host (root 0700: limits, the action log). No network at all.
[Unit]
Description=Ainkrad host helper
Documentation=https://github.com/AinkradHQ/AinkradCore
CollectMode=inactive-or-failed

[Service]
Type=exec
User=root
ExecStart=/usr/local/bin/ainkrad-host
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=30
StateDirectory=ainkrad-host
StateDirectoryMode=0700
UMask=0077
LimitCORE=0

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
# Root without capabilities owns the journal, /run/systemd/private and /usr/local/bin already. The one it needs: reading the
# metadata of the Core's backups under /var/lib/ainkrad (ainkrad 0750), for `backup_info`. Never CAP_SYS_ADMIN.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
